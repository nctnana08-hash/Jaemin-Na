{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with role and settings.",
      "type": "object",
      "properties": {
        "fullName": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["student", "instructor", "admin"] },
        "learningMode": { "type": "string", "enum": ["self_paced", "class_based"] },
        "selectedFocus": { "type": "string" },
        "activeClassId": { "type": "string" },
        "diagnosticCompleted": { "type": "boolean" },
        "onboardingStep": { "type": "number" },
        "photoURL": { "type": "string" }
      },
      "required": ["email", "role"]
    },
    "Category": {
      "title": "Category",
      "description": "A curriculum category or subject domain.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "questionCount": { "type": "number" }
      },
      "required": ["name"]
    },
    "Topic": {
      "title": "Topic",
      "description": "A topic within a category.",
      "type": "object",
      "properties": {
        "categoryId": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["categoryId", "name"]
    },
    "Question": {
      "title": "Question",
      "description": "A multiple choice question.",
      "type": "object",
      "properties": {
        "stem": { "type": "string" },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "text": { "type": "string" }
            }
          }
        },
        "correctOptionId": { "type": "string" },
        "categoryId": { "type": "string" },
        "topicId": { "type": "string" },
        "difficulty": { "type": "string", "enum": ["Easy", "Medium", "Hard"] }
      },
      "required": ["stem", "options", "correctOptionId", "categoryId"]
    },
    "Class": {
      "title": "Class",
      "description": "A group of students managed by an instructor.",
      "type": "object",
      "properties": {
        "className": { "type": "string" },
        "description": { "type": "string" },
        "classCode": { "type": "string" },
        "instructorId": { "type": "string" },
        "instructorName": { "type": "string" },
        "inviteLink": { "type": "string" },
        "focus": { "type": "string" },
        "specializationName": { "type": "string" },
        "assignedModuleIds": { "type": "array", "items": { "type": "string" } },
        "studentCount": { "type": "number" },
        "status": { "type": "string" }
      }
    },
    "LearnerProfile": {
      "title": "Learner Profile",
      "description": "Assessment-based baseline and progress.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "baselineScore": { "type": "number" },
        "strengths": { "type": "array", "items": { "type": "string" } },
        "weaknesses": { "type": "array", "items": { "type": "string" } },
        "recommendedPath": { "type": "string" }
      }
    },
    "QuizAttempt": {
      "title": "Quiz Attempt",
      "description": "Records of a student's quiz.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "score": { "type": "number" },
        "total": { "type": "number" },
        "completedAt": { "type": "number" },
        "answers": { "type": "object" }
      }
    },
    "Badge": {
      "title": "Badge",
      "description": "Gamification achievement.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "icon": { "type": "string" },
        "rarity": { "type": "string" }
      }
    },
    "Report": {
      "title": "Report",
      "description": "User reported issue or request.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "subject": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["open", "resolved"] },
        "createdAt": { "type": "number" }
      },
      "required": ["userId", "subject", "description"]
    },
    "StudioPresence": {
      "title": "Studio Presence",
      "description": "Collaboration real-time user active presence in module edit studio.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userEmail": { "type": "string" },
        "avatarInitials": { "type": "string" },
        "moduleId": { "type": "string" },
        "lastActiveAt": { "type": "number" }
      },
      "required": ["userId", "moduleId", "lastActiveAt"]
    }
  },
  "firestore": {
    "/users/{userId}": { "schema": "User", "description": "Global user directory." },
    "/categories/{categoryId}": { "schema": "Category", "description": "Curriculum categories." },
    "/topics/{topicId}": { "schema": "Topic", "description": "Topics within categories." },
    "/questions/{questionId}": { "schema": "Question", "description": "Question bank." },
    "/classes/{classId}": { "schema": "Class", "description": "Instructor classes." },
    "/learnerProfiles/{userId}": { "schema": "LearnerProfile", "description": "Adaptive data." },
    "/quizAttempts/{attemptId}": { "schema": "QuizAttempt", "description": "Quiz results history." },
    "/diagnosticAttempts/{attemptId}": { "schema": "QuizAttempt", "description": "Initial assessment results." },
    "/badges/{badgeId}": { "schema": "Badge", "description": "Available achievements." },
    "/reports/{reportId}": { "schema": "Report", "description": "Support tickets." },
    "/studioPresence/{presenceId}": { "schema": "StudioPresence", "description": "Tracks real-time active users editing specific items in the studio workspace." }
  }
}
